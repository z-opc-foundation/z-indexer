<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 直接继承 z-indexer 顶层（reversion 机制根） -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-indexer</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>z-indexer-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>z-indexer-spring-boot-starter</name>
    <description>z-indexer Spring Boot starter - REST API + 装配 + 调度</description>

    <!-- 这里原来重复定义了 maven.compiler.source/target=8、java.version=8、
         project.build.sourceEncoding=UTF-8：与父链（z-boot-parent）面值相同（java.version 那格
         父链是 1.8，javac 里同义），删掉后由 parent 下发，实测进 javac 的仍是 8。 -->

    <dependencies>
        <!-- z-indexer-core -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-indexer-core</artifactId>
        </dependency>

        <!-- z-boot 聚合 starter: 一行 import 集成 z-config 配置中心 + 客户端 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-config-starter</artifactId>
        </dependency>

        <!-- z-boot 聚合 starter: z-gw 网关客户端（提供 z-opc 内部 HTTP 调用能力） -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-gw-starter</artifactId>
        </dependency>

        <!-- z-boot 聚合 starter: z-cache Redis 客户端 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-cache-starter</artifactId>
        </dependency>

        <!-- Spring Boot Web (REST) - 通过 z-boot-integration-starters BOM 提供版本 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Redis 客户端 (RedisProbeController 用 StringRedisTemplate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- JSON: 走 z-util-parser-json (与 z-indexer-core 同源，避免重复声明 fastjson) -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-parser-json</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>z-indexer-spring-boot-starter</finalName>
        <!-- 这里原来声明过 spring-boot-maven-plugin + <mainClass>IndexerApplication</mainClass>：
             那枚主类属于**进程**，不属于库，2026-09-29 随 IndexerApplication / application.yaml /
             bootstrap.yaml / bin/ 一起搬到 z-indexer-server（见那里的注释：这条搬运把发布 jar 从
             49MB 打回库该有的大小，也把 classpath:/application.yaml 这个"库替消费者定配置"的口子
             关掉）。本模块没有 <executions>，两侧都不会跑 repackage —— 现在连那条误导性的声明也没了。 -->
    </build>
</project>