<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 直接继承 z-indexer 顶层（reversion 机制根） -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-indexer</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>z-indexer-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>z-indexer-spring-boot-starter</name>
    <description>z-indexer Spring Boot starter - REST API + 装配 + 调度</description>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <java.version>8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- z-indexer-core -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-indexer-core</artifactId>
        </dependency>

        <!-- z-boot 聚合 starter: 一行 import 集成 z-config 配置中心 + 客户端 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-config-starter</artifactId>
        </dependency>

        <!-- z-boot 聚合 starter: z-gw 网关客户端（提供 z-opc 内部 HTTP 调用能力） -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-gw-starter</artifactId>
        </dependency>

        <!-- z-boot 聚合 starter: z-cache Redis 客户端 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-cache-starter</artifactId>
        </dependency>

        <!-- Spring Boot Web (REST) - 通过 z-boot-integration-starters BOM 提供版本 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Redis 客户端 (RedisProbeController 用 StringRedisTemplate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- JSON: 走 z-util-parser-json (与 z-indexer-core 同源，避免重复声明 fastjson) -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-parser-json</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>z-indexer-spring-boot-starter</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.zifang.z.indexer.IndexerApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>